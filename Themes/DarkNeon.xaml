<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== COLOR PALETTE ===================== -->
    <Color x:Key="ColBg">#0B0B12</Color>
    <Color x:Key="ColBgDeep">#06060B</Color>
    <Color x:Key="ColBgGlow">#191634</Color>
    <Color x:Key="ColSidebar">#0F0F18</Color>
    <Color x:Key="ColCard">#14141F</Color>
    <Color x:Key="ColCardHover">#191927</Color>
    <Color x:Key="ColBorder">#23232F</Color>
    <Color x:Key="ColBorderStrong">#33334A</Color>
    <Color x:Key="ColTextPrimary">#F3F3FA</Color>
    <Color x:Key="ColTextSecondary">#9A9AB3</Color>
    <Color x:Key="ColTextMuted">#6B6B82</Color>

    <Color x:Key="ColNeonPink">#F0286F</Color>
    <Color x:Key="ColNeonPurple">#7B5CFA</Color>
    <Color x:Key="ColNeonGreen">#33E39A</Color>
    <Color x:Key="ColRiskSafe">#33E39A</Color>
    <Color x:Key="ColRiskMod">#FFC53D</Color>
    <Color x:Key="ColRiskHigh">#F0286F</Color>

    <SolidColorBrush x:Key="BrushBg" Color="{StaticResource ColBg}"/>
    <SolidColorBrush x:Key="BrushSidebar" Color="{StaticResource ColSidebar}"/>
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColCard}"/>
    <SolidColorBrush x:Key="BrushCardHover" Color="{StaticResource ColCardHover}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColBorder}"/>
    <SolidColorBrush x:Key="BrushBorderStrong" Color="{StaticResource ColBorderStrong}"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColTextMuted}"/>
    <SolidColorBrush x:Key="BrushNeonPink" Color="{StaticResource ColNeonPink}"/>
    <SolidColorBrush x:Key="BrushNeonPurple" Color="{StaticResource ColNeonPurple}"/>
    <SolidColorBrush x:Key="BrushNeonGreen" Color="{StaticResource ColNeonGreen}"/>
    <SolidColorBrush x:Key="BrushRiskSafe" Color="{StaticResource ColRiskSafe}"/>
    <SolidColorBrush x:Key="BrushRiskMod" Color="{StaticResource ColRiskMod}"/>
    <SolidColorBrush x:Key="BrushRiskHigh" Color="{StaticResource ColRiskHigh}"/>

    <!-- Translucent card surfaces so the looping background video subtly
         shows through behind the cards. Text stays fully opaque so
         readability is unaffected. -->
    <SolidColorBrush x:Key="BrushCardTranslucent" Color="#D216161F"/>
    <SolidColorBrush x:Key="BrushCardTranslucentHover" Color="#EA1D1D2C"/>

    <!-- ===================== ACCENT VARIANTS ===================== -->
    <!-- Derived tints of the accent color. These, the ColNeonPurple/Pink and
         ColBgGlow entries above are managed at runtime by ThemeService, which
         swaps them (and mutates the shared brush instances) when the user
         picks a different UI color in the appearance window. -->
    <Color x:Key="ColAccentSoft">#667B5CFA</Color>
    <Color x:Key="ColAccentSoftFade">#007B5CFA</Color>
    <Color x:Key="ColAccentDim">#4A3690</Color>
    <Color x:Key="ColAccentGhost">#557B5CFA</Color>
    <SolidColorBrush x:Key="BrushAccentGhost" Color="{StaticResource ColAccentGhost}"/>

    <!-- Window background: a purple halo in the center, darkening toward the edges -->
    <RadialGradientBrush x:Key="BrushBackdrop" GradientOrigin="0.5,0.40" Center="0.5,0.40"
                         RadiusX="0.9" RadiusY="0.9">
        <GradientStop Color="{StaticResource ColBgGlow}" Offset="0"/>
        <GradientStop Color="{StaticResource ColBg}" Offset="0.6"/>
        <GradientStop Color="{StaticResource ColBgDeep}" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="BrushSidebarGrad" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#13131F" Offset="0"/>
        <GradientStop Color="#0A0A11" Offset="1"/>
    </LinearGradientBrush>

    <!-- Thin neon line separating the sidebar from the content -->
    <LinearGradientBrush x:Key="BrushSidebarEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#4C7B5CFA" Offset="0.5"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- Subtle neon glow for cards and buttons -->
    <DropShadowEffect x:Key="GlowPink" Color="{StaticResource ColNeonPink}" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
    <DropShadowEffect x:Key="GlowPurple" Color="{StaticResource ColNeonPurple}" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
    <DropShadowEffect x:Key="GlowGreen" Color="{StaticResource ColNeonGreen}" BlurRadius="16" ShadowDepth="0" Opacity="0.45"/>

    <!-- Shared easing curve for animations -->
    <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BrushBg}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextPrimary}"/>
    </Style>

    <!-- ===================== SCROLLBAR (dark theme, no arrow buttons) ===================== -->
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" Background="#2E2E44" CornerRadius="4" Margin="3,0"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{DynamicResource BrushNeonPurple}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{DynamicResource BrushNeonPink}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True"
                               Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== SIDEBAR NAV ITEM ===================== -->
    <!-- When selected, a purple accent bar expands top-to-bottom; on hover the text slides slightly right -->
    <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="8,2"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AccentBar" Grid.Column="0" Width="3" CornerRadius="2"
                                    Background="{DynamicResource BrushNeonPurple}" Opacity="0"
                                    Margin="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SidebarAccentOffset}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="0.2"/>
                                </Border.RenderTransform>
                            </Border>
                            <ContentPresenter x:Name="Cp" Grid.Column="1"
                                              Margin="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SidebarContentOffset}"
                                              VerticalAlignment="Center"
                                              RenderTransformOrigin="0,0.5">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushCardHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Cp" Storyboard.TargetProperty="RenderTransform.X"
                                                         To="4" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Cp" Storyboard.TargetProperty="RenderTransform.X"
                                                         To="0" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushCardHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="0.2" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Collapsed icon rail (window's SidebarExpanded = False): drop the
             wide-mode insets so the icons center cleanly in the 64px rail
             instead of being pushed right and clipped. -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SidebarExpanded}" Value="False">
                <Setter Property="Padding" Value="0,10"/>
                <Setter Property="Margin" Value="6,2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SidebarItemStyle}"/>
    </Style>

    <!-- ===================== NEON TEXT INPUT ===================== -->
    <!-- Dark field with a purple glow while focused -->
    <Style x:Key="NeonInput" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="Background" Value="#16161F"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="CaretBrush" Value="{DynamicResource BrushNeonPurple}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource BrushAccentGhost}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushNeonPurple}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NeonPassword" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="Background" Value="#16161F"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="CaretBrush" Value="{DynamicResource BrushNeonPurple}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource BrushAccentGhost}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushNeonPurple}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small field label above an input -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="Margin" Value="2,14,0,6"/>
    </Style>

    <!-- Inline validation message -->
    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#F0286F"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>

    <!-- ===================== NEON TOGGLE SWITCH ===================== -->
    <!-- The thumb slides with a light spring, and the track color transitions smoothly -->
    <Style x:Key="NeonToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" Width="46" Height="26" CornerRadius="13"
                            BorderThickness="0" RenderTransformOrigin="0.5,0.5">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource ColBorderStrong}"/>
                        </Border.Background>
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Border x:Name="Thumb" Width="20" Height="20" CornerRadius="10"
                                Background="#E7E7EF" HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Border.RenderTransform>
                                <TranslateTransform X="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="RenderTransform.X"
                                                         To="20" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Background.Color"
                                                        To="{StaticResource ColNeonPink}" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="RenderTransform.X"
                                                         To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Background.Color"
                                                        To="{StaticResource ColBorderStrong}" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Grows slightly on hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1.08" Duration="0:0:0.15" EasingFunction="{StaticResource EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1.08" Duration="0:0:0.15" EasingFunction="{StaticResource EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Squash feel on press -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="0.92" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="0.92" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1.08" Duration="0:0:0.16" EasingFunction="{StaticResource EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1.08" Duration="0:0:0.16" EasingFunction="{StaticResource EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== NEON PILL BUTON ===================== -->
    <!-- Hover: grows + neon border. Click: squashes inward, springs back on release. -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushCardHover}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18"
                            Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushNeonPink}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                          To="1.05" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                          To="1.05" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                          To="1" Duration="0:0:0.25" EasingFunction="{StaticResource EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                          To="1" Duration="0:0:0.25" EasingFunction="{StaticResource EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                          To="0.95" Duration="0:0:0.07"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                          To="0.95" Duration="0:0:0.07"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                          To="1.05" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                          To="1.05" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary translucent pill button (for cancel / alternate / free actions) -->
    <Style x:Key="PillButtonSecondary" TargetType="Button">
        <Setter Property="Background" Value="#12121B"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18"
                            Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushCardHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushNeonPurple}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1C1C28"/>
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ===================== RESOURCE MONITOR (Home page) ===================== -->
    <Style x:Key="MonitorValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
    </Style>

    <Style x:Key="MonitorLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
    </Style>

    <!-- Slim neon usage bar (CPU / RAM / Disk) -->
    <Style x:Key="MonitorBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Setter Property="Background" Value="#1F1F2E"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushNeonPurple}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Height="{TemplateBinding Height}" CornerRadius="3"
                                Background="{TemplateBinding Background}"/>
                        <Border x:Name="PART_Track"/>
                        <Border x:Name="PART_Indicator" CornerRadius="3"
                                Background="{TemplateBinding Foreground}"
                                HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== NEON COMBO BOX ===================== -->
    <!-- Dark dropdown used for the language selector. -->
    <Style x:Key="NeonComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushCardHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2A2A3E"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushNeonPurple}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NeonCombo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="Background" Value="#16161F"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource NeonComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="#16161F" BorderBrush="{StaticResource BrushBorderStrong}"
                                            BorderThickness="1" CornerRadius="10">
                                        <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource BrushTextMuted}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushNeonPurple}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Selected" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}" HorizontalAlignment="Left"
                                          VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                            <Border Background="#16161F" BorderBrush="{StaticResource BrushBorderStrong}"
                                    BorderThickness="1" CornerRadius="10" Margin="0,4,0,0" Padding="4"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer MaxHeight="220">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource BrushNeonPurple}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== GENERAL BUTTON ===================== -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushCardHover}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"
                            Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushNeonPurple}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                          To="1.04" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                          To="1.04" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                          To="1" Duration="0:0:0.25" EasingFunction="{StaticResource EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                          To="1" Duration="0:0:0.25" EasingFunction="{StaticResource EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                          To="0.95" Duration="0:0:0.07"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                          To="0.95" Duration="0:0:0.07"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                          To="1.04" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                          To="1.04" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ===================== NEON SLIDER ===================== -->
    <!-- Draggable slider on a dark track with a neon filled range and a
         glowing round thumb. Snapping (if enabled on the instance) is
         functional only - no tick marks are drawn, so the same style works
         for 9-step RAM sizes and 256-step RGB channels alike. Accent parts
         use DynamicResource so the slider recolors with the theme. Used by
         the RAM profile card and the appearance window custom color
         picker. -->
        <Style x:Key="NeonSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="8"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <!-- Full-length dark track -->
                            <Border Height="6" CornerRadius="3" Background="#22222F"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <!-- Filled range to the left of the thumb -->
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent">
                                                    <Border Height="6" CornerRadius="3"
                                                            Background="{DynamicResource BrushNeonPurple}"
                                                            VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse Width="18" Height="18"
                                                             Fill="{StaticResource BrushCard}"
                                                             Stroke="{DynamicResource BrushNeonPurple}"
                                                             StrokeThickness="2">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="{DynamicResource ColNeonPurple}"
                                                                              BlurRadius="16" ShadowDepth="0" Opacity="0.85"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</ResourceDictionary>
