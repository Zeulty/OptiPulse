<Window x:Class="ChlorideTweaks.TweakDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ChlorideTweaks.Converters"
        xmlns:services="clr-namespace:ChlorideTweaks.Services"
        Title="Tweak details" Width="640" Height="700"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBackdrop}">

    <Window.Resources>
        <conv:RiskToBrushConverter x:Key="RiskToBrush"/>
        <conv:RiskToColorConverter x:Key="RiskToColor"/>
        <conv:RiskToLabelConverter x:Key="RiskToLabel"/>
        <conv:BoolToVisConverter x:Key="BoolToVis"/>

        <!-- Section heading inside the details window -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="Margin" Value="0,18,0,6"/>
        </Style>

        <!-- Section body text -->
        <Style x:Key="SectionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Soft halo in the background -->
        <Ellipse IsHitTestVisible="False" Opacity="0.4" Margin="-80">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource ColAccentDim}" Offset="0"/>
                    <GradientStop Color="#00151528" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Margin="28,24,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ HEADER: name + risk pill ============ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LocalName}" FontSize="21" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextWrapping="Wrap">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{DynamicResource ColNeonPurple}" BlurRadius="18"
                                                  ShadowDepth="0" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding LocalCategory}" FontSize="11.5" Margin="0,4,0,0"
                               Foreground="{StaticResource BrushTextMuted}"/>
                </StackPanel>

                <!-- Risk pill: green / yellow / red -->                <Border Grid.Column="1" VerticalAlignment="Top" CornerRadius="10" Padding="12,6"
                        Background="{Binding Risk, Converter={StaticResource RiskToBrush}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.55"
                                          Color="{Binding Risk, Converter={StaticResource RiskToColor}}"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#0B0B12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding LocalRiskLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0B0B12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ BODY: sections ============ -->
            <Border Grid.Row="1" Margin="0,16,0,0" CornerRadius="14" Padding="22,6,22,16"
                    Background="{StaticResource BrushCardTranslucent}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,10,0,0">

                        <TextBlock Text="{Binding [SecWhatItDoes], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding LocalDescription}" Style="{StaticResource SectionText}"/>

                        <TextBlock Text="{Binding [SecWhoFor], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding LocalWhoFor}" Style="{StaticResource SectionText}"/>

                        <TextBlock Text="{Binding [SecPurpose], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding LocalPurpose}" Style="{StaticResource SectionText}"/>

                        <TextBlock Text="{Binding [SecSideEffects], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SectionLabel}"/>
                        <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚠" FontSize="13" Margin="0,2,8,0" VerticalAlignment="Top"
                                           Foreground="{Binding Risk, Converter={StaticResource RiskToBrush}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding LocalSideEffect}" Style="{StaticResource SectionText}"/>
                            </Grid>
                        </Border>

                        <!-- Revert availability note -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}"
                                     Fill="{StaticResource BrushNeonGreen}"/>
                            <TextBlock Grid.Column="1" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource BrushTextMuted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding [RevertNo], Source={x:Static services:LocalizationService.Instance}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanRevert}" Value="True">
                                                <Setter Property="Text" Value="{Binding [RevertYes], Source={x:Static services:LocalizationService.Instance}}"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                            </DataTrigger>
                                            <!-- One-shot cleanups can never be reverted; the
                                                 note always reflects that, even if a state
                                                 was somehow saved. -->
                                            <DataTrigger Binding="{Binding OneShot}" Value="True">
                                                <Setter Property="Text" Value="{Binding [RevertOneShot], Source={x:Static services:LocalizationService.Instance}}"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============ FOOTER: live status + apply/revert ============ -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{StaticResource BrushNeonGreen}"
                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource BrushTextMuted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding [StatusNotApplied], Source={x:Static services:LocalizationService.Instance}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                        <Setter Property="Text" Value="{Binding [StatusApplied], Source={x:Static services:LocalizationService.Instance}}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource PillButton}"
                        Command="{Binding ToggleCommand}" IsEnabled="{Binding CanToggle}"
                        MinWidth="170" VerticalAlignment="Center">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding [BtnApply], Source={x:Static services:LocalizationService.Instance}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                        <Setter Property="Text" Value="{Binding [BtnRevert], Source={x:Static services:LocalizationService.Instance}}"/>
                                    </DataTrigger>
                                    <!-- One-shot actions (cleanups) can never be reverted:
                                         "Run now" always wins over the revert label. -->
                                    <DataTrigger Binding="{Binding OneShot}" Value="True">
                                        <Setter Property="Text" Value="{Binding [BtnRunNow], Source={x:Static services:LocalizationService.Instance}}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
