<Window x:Class="ChlorideTweaks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ChlorideTweaks.Converters"
        xmlns:services="clr-namespace:ChlorideTweaks.Services"
        Title="OptiPulse" Height="720" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBackdrop}">

    <Window.Resources>
        <conv:BoolToVisConverter x:Key="BoolToVis"/>
        <conv:RiskToBrushConverter x:Key="RiskToBrush"/>
        <conv:RiskToColorConverter x:Key="RiskToColor"/>
        <conv:RiskToLabelConverter x:Key="RiskToLabel"/>

        <!-- Stat cards on the Home screen -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushCardTranslucent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <!-- Design of a single tweak card: the colored dot shows the risk
             (green/yellow/red), clicking the card opens the details window,
             and the switch applies (ON) or reverts (OFF) the tweak. -->
        <!-- Small muted label under the RAM slider -->
        <Style x:Key="RamTick" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <DataTemplate x:Key="TweakCardTemplate">
            <!-- Big square tile: easy to scan for non-technical users. The
                 whole tile opens the details window; the switch (or the run
                 button for one-shot cleanups) sits in the bottom corner. -->
            <Border x:Name="CardBorder" Background="{StaticResource BrushCardTranslucent}" BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="16" Padding="16,14" Margin="0,0,12,12"
                    Width="228" MinHeight="168" Cursor="Hand" SnapsToDevicePixels="True"
                    ToolTip="{Binding [CardTooltip], Source={x:Static services:LocalizationService.Instance}}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DetailsCommand}"/>
                </Border.InputBindings>
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                                                  To="-4" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                                                  To="0" Duration="0:0:0.25" EasingFunction="{StaticResource EaseOut}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Risk indicator: green = safe, yellow = moderate, red = high -->
                        <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                 Fill="{Binding Risk, Converter={StaticResource RiskToBrush}}"
                                 ToolTip="{Binding Risk, Converter={StaticResource RiskToLabel}}"/>

                    </Grid>

                    <!-- The tweak name, big and readable -->
                    <TextBlock Grid.Row="1" Text="{Binding LocalName}" FontSize="15.5" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,10,4,0" VerticalAlignment="Top"
                               Foreground="{StaticResource BrushTextPrimary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Opacity" Value="1"/>
                                <Style.Triggers>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Hint / busy status -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding [ClickDetails], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="10" Margin="8,0,0,0"
                                   Foreground="{StaticResource BrushNeonGreen}"
                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <!-- Bottom row: the control. The switch: ON applies the
                         tweak, OFF reverts it. One-shot actions (file
                         cleanups) have nothing to revert, so they show a
                         single run button instead. -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Style="{StaticResource PillButton}" MinWidth="96" Padding="14,6"
                                Command="{Binding ToggleCommand}"
                                IsEnabled="{Binding CanToggle}"
                                Visibility="{Binding OneShot, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding [BtnRunNow], Source={x:Static services:LocalizationService.Instance}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" FontSize="9" VerticalAlignment="Center" Margin="0,0,7,0"
                                           Foreground="{DynamicResource BrushNeonGreen}"/>
                                <TextBlock Text="{Binding [BtnRunNow], Source={x:Static services:LocalizationService.Instance}}"/>
                            </StackPanel>
                        </Button>
                        <ToggleButton Style="{StaticResource NeonToggle}"
                                      IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                      IsEnabled="{Binding CanToggle}"
                                      Command="{Binding ToggleCommand}"
                                      Visibility="{Binding IsToggleable, Converter={StaticResource BoolToVis}}"
                                      ToolTip="{Binding [ToggleTooltip], Source={x:Static services:LocalizationService.Instance}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== BACKGROUND VIDEO ===================== -->
        <!-- Loops until the app closes. The darkening scrim above it uses
             FIXED colors (never touched by the appearance/theme system), so
             accent color changes only recolor buttons and other chrome -
             the video itself always looks exactly as authored. -->
        <MediaElement x:Name="BackgroundVideo" Grid.ColumnSpan="2"
                      LoadedBehavior="Manual" UnloadedBehavior="Close"
                      IsMuted="True" Volume="0" Stretch="UniformToFill"
                      RenderOptions.BitmapScalingMode="LowQuality"
                      IsHitTestVisible="False" Panel.ZIndex="-2"
                      MediaOpened="BackgroundVideo_MediaOpened"
                      MediaEnded="BackgroundVideo_MediaEnded"
                      MediaFailed="BackgroundVideo_MediaFailed"/>
        <Border Grid.ColumnSpan="2" IsHitTestVisible="False" Panel.ZIndex="-1">
            <Border.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.42" Center="0.5,0.42"
                                     RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#C21A172F" Offset="0"/>
                    <GradientStop Color="#E50C0C14" Offset="0.55"/>
                    <GradientStop Color="#F607070C" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- ===================== SIDEBAR ===================== -->
        <Grid Grid.Column="0">
            <!-- Semi-transparent so the video subtly bleeds through; fixed
                 colors, unaffected by the appearance palette. -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#EA13131F" Offset="0"/>
                        <GradientStop Color="#F20A0A11" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel LastChildFill="True">
                    <!-- Top row: brand (hidden in the collapsed rail) + the
                         collapse/expand toggle. Symmetric margins so the
                         centered hamburger lands mid-rail when collapsed. -->
                    <Grid DockPanel.Dock="Top" Margin="12,16,12,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SidebarExpanded, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="OptiPulse" FontSize="19" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="{DynamicResource ColNeonPurple}" BlurRadius="16"
                                                          ShadowDepth="0" Opacity="0.75"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock x:Name="VersionText" Text="v1.0.5" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="SidebarToggleButton" Click="SidebarToggleButton_Click" Cursor="Hand"
                                Width="30" Height="30" VerticalAlignment="Center"
                                HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SidebarToggleAlignment}"
                                ToolTip="{Binding [SidebarToggleTooltip], Source={x:Static services:LocalizationService.Instance}}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="Transparent" CornerRadius="8">
                                                    <TextBlock Text="☰" FontSize="15" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#1FBFBFFF"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushNeonPurple}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Language selector (hidden in the collapsed rail) -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="14,8,14,0"
                                Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SidebarExpanded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding [LanguageLabel], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" Margin="2,0,0,5"/>
                        <ComboBox x:Name="LanguageBox" Style="{StaticResource NeonCombo}" SelectionChanged="LanguageBox_SelectionChanged">
                            <ComboBoxItem Content="English" Tag="en"/>
                            <ComboBoxItem Content="Türkçe" Tag="tr"/>
                            <ComboBoxItem Content="Español" Tag="es"/>
                            <ComboBoxItem Content="中文" Tag="zh"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Appearance: opens the accent color palette (every user).
                         The wide pill shows when expanded; the collapsed rail
                         gets a compact round icon button instead, so nothing
                         is squished at 64px. -->
                    <Button x:Name="AppearanceButton" DockPanel.Dock="Bottom" Margin="10,8,10,0"
                            Style="{StaticResource PillButton}" HorizontalAlignment="Stretch"
                            Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SidebarExpanded, Converter={StaticResource BoolToVis}}"
                            Click="AppearanceButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource BrushNeonPurple}"
                                     VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Text="{Binding [Appearance], Source={x:Static services:LocalizationService.Instance}}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AppearanceRailButton" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                            Width="34" Height="34" Cursor="Hand" Click="AppearanceButton_Click"
                            HorizontalAlignment="Center"
                            ToolTip="{Binding [Appearance], Source={x:Static services:LocalizationService.Instance}}"
                            Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SidebarCollapsed, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="9">
                                                <Ellipse Width="12" Height="12" Fill="{DynamicResource BrushNeonPurple}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#1FBFBFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Background video pause/play toggle: pauses the background video in place
                         as a static frame to save GPU/CPU on older PCs, or resumes playback. -->
                    <Button x:Name="VideoToggleButton" DockPanel.Dock="Bottom" Margin="10,8,10,0"
                            Style="{StaticResource PillButton}" HorizontalAlignment="Stretch"
                            ToolTip="{Binding [BgVideoTooltip], Source={x:Static services:LocalizationService.Instance}}"
                            Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SidebarExpanded, Converter={StaticResource BoolToVis}}"
                            Click="VideoToggleButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="VideoToggleIcon" Text="⏸" FontSize="11"
                                       Foreground="{DynamicResource BrushNeonGreen}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="VideoToggleText" Text="Pause Background" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="VideoToggleRailButton" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                            Width="34" Height="34" Cursor="Hand" Click="VideoToggleButton_Click"
                            HorizontalAlignment="Center"
                            ToolTip="{Binding [BgVideoTooltip], Source={x:Static services:LocalizationService.Instance}}"
                            Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SidebarCollapsed, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="9">
                                                <TextBlock x:Name="VideoToggleRailIcon" Text="🖼" FontSize="14"
                                                           Foreground="{DynamicResource BrushNeonPurple}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#1FBFBFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Category navigation: logo + localized name; in the
                         collapsed rail only the centered logos remain and the
                         labels fade out (never clipped away). -->
                    <ListBox x:Name="CategoryList" ItemsSource="{Binding Categories}"
                             SelectionChanged="CategoryList_SelectionChanged" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Display}"
                                            HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SidebarItemsAlignment}">
                                    <TextBlock Text="{Binding Logo}" FontSize="15" VerticalAlignment="Center"
                                               Margin="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SidebarIconMargin}"/>
                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                               Opacity="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SidebarLabelOpacity}"
                                               Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Thin neon edge separating the sidebar from the content -->
            <Border Width="1" HorizontalAlignment="Right" Background="{DynamicResource BrushSidebarEdge}"
                    IsHitTestVisible="False"/>
        </Grid>

        <!-- ===================== MAIN CONTENT ===================== -->
        <Grid Grid.Column="1" ClipToBounds="True">

            <!-- Page body: the fade + slide-up animation is applied to this when the category changes -->
            <Grid x:Name="PageHost" Margin="28,24,28,24" Panel.ZIndex="1">
                <Grid.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Home panel (scrollable: welcome header + system info) -->
                <ScrollViewer x:Name="WelcomePanel" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="WelcomeText" Text="Welcome back" FontSize="26" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="{DynamicResource ColNeonPurple}" BlurRadius="20"
                                                          ShadowDepth="0" Opacity="0.55"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="{Binding [AppSubtitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="13"
                                           Foreground="{StaticResource BrushTextSecondary}" Margin="0,8,0,0"/>
                            </StackPanel>

                            <!-- PC info badge: Windows version + live 12-hour clock + timezone -->
                            <Border Grid.Column="1" Style="{StaticResource StatCard}" Padding="14,10" VerticalAlignment="Top">
                                <StackPanel HorizontalAlignment="Right">
                                    <TextBlock x:Name="OsVersionText" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="ClockText" FontSize="17" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}"
                                               Margin="0,3,0,0" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="TimeZoneText" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}"
                                               Margin="0,3,0,0" HorizontalAlignment="Right" TextWrapping="Wrap" MaxWidth="240"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ===================== SYSTEM INFORMATION ===================== -->
                        <!-- Filled asynchronously from SystemInfoService; fades in when ready. -->
                        <StackPanel x:Name="SystemInfoPanel" Margin="0,34,0,0" Opacity="0">

                            <TextBlock Text="{Binding [SystemInfo], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextMuted}"/>
                            <Border Height="1" Margin="0,8,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{DynamicResource ColAccentSoft}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource ColAccentSoftFade}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <UniformGrid Columns="3" Margin="0,14,0,0">

                                <!-- Processor -->
                                <Border Style="{StaticResource StatCard}" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [Processor], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextMuted}"/>
                                        <TextBlock x:Name="CpuNameText" Text="{Binding [Detecting], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                        <TextBlock x:Name="CpuDetailText" Text=" " FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Graphics -->
                                <Border Style="{StaticResource StatCard}" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [Graphics], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextMuted}"/>
                                        <TextBlock x:Name="GpuNameText" Text="{Binding [Detecting], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                        <TextBlock x:Name="GpuDetailText" Text=" " FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Memory -->
                                <Border Style="{StaticResource StatCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [Memory], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextMuted}"/>
                                        <TextBlock x:Name="RamText" Text="{Binding [Detecting], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                        <TextBlock x:Name="RamDetailText" Text=" " FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Motherboard -->
                                <Border Style="{StaticResource StatCard}" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [Motherboard], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextMuted}"/>
                                        <TextBlock x:Name="BoardText" Text="{Binding [Detecting], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                        <TextBlock x:Name="BoardDetailText" Text=" " FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Storage -->
                                <Border Style="{StaticResource StatCard}" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [Storage], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextMuted}"/>
                                        <TextBlock x:Name="StorageText" Text="{Binding [Detecting], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                        <TextBlock x:Name="StorageDetailText" Text=" " FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Display -->
                                <Border Style="{StaticResource StatCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [Display], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextMuted}"/>
                                        <TextBlock x:Name="DisplayText" Text="{Binding [Detecting], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                        <TextBlock x:Name="DisplayDetailText" Text=" " FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Secure Boot status -->
                                <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [SecureBoot], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextMuted}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <Ellipse x:Name="SecureBootDot" Width="8" Height="8" VerticalAlignment="Center"
                                                     Margin="0,0,8,0" Fill="{StaticResource BrushTextMuted}"/>
                                            <TextBlock x:Name="SecureBootText" Text="{Binding [Detecting], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTextPrimary}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="SecureBootDetailText" Text=" " FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- TPM status -->
                                <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [Tpm], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextMuted}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <Ellipse x:Name="TpmDot" Width="8" Height="8" VerticalAlignment="Center"
                                                     Margin="0,0,8,0" Fill="{StaticResource BrushTextMuted}"/>
                                            <TextBlock x:Name="TpmText" Text="{Binding [Detecting], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTextPrimary}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TpmDetailText" Text=" " FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Uptime -->
                                <Border Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [Uptime], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextMuted}"/>
                                        <TextBlock x:Name="UptimeText" Text="{Binding [Detecting], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,7,0,0"/>
                                        <TextBlock x:Name="UptimeDetailText" Text=" " FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>

                        <!-- ===================== LIVE RESOURCE MONITORS ===================== -->
                        <!-- CPU / memory / disk usage, sampled on a background thread
                             every 1.5 s and only while the Home page is visible. -->
                        <StackPanel x:Name="ResourceMonitors" Margin="0,34,0,0">
                            <TextBlock Text="{Binding [ResourceMonitors], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextMuted}"/>
                            <Border Height="1" Margin="0,8,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{DynamicResource ColAccentSoft}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource ColAccentSoftFade}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <UniformGrid Columns="3" Margin="0,14,0,0">

                                <!-- CPU -->
                                <Border Style="{StaticResource StatCard}" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [MonitorCpu], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource MonitorLabel}"/>
                                        <TextBlock x:Name="CpuValueText" Text="—" Style="{StaticResource MonitorValue}" Margin="0,7,0,0"/>
                                        <ProgressBar x:Name="CpuBar" Style="{StaticResource MonitorBar}"/>
                                        <TextBlock x:Name="CpuLoadText" Text=" " FontSize="10.5"
                                                   Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Memory -->
                                <Border Style="{StaticResource StatCard}" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [MonitorMemory], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource MonitorLabel}"/>
                                        <TextBlock x:Name="MemValueText" Text="—" Style="{StaticResource MonitorValue}" Margin="0,7,0,0"/>
                                        <ProgressBar x:Name="MemBar" Style="{StaticResource MonitorBar}"/>
                                        <TextBlock x:Name="MemDetailText" Text=" " FontSize="10.5"
                                                   Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Disk -->
                                <Border Style="{StaticResource StatCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [MonitorDisk], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource MonitorLabel}"/>
                                        <TextBlock x:Name="DiskValueText" Text="—" Style="{StaticResource MonitorValue}" Margin="0,7,0,0"/>
                                        <ProgressBar x:Name="DiskBar" Style="{StaticResource MonitorBar}"/>
                                        <TextBlock x:Name="DiskDetailText" Text=" " FontSize="10.5"
                                                   Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                            </UniformGrid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Game Launcher panel -->
                <ScrollViewer x:Name="GameLauncherPanel" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,10,20">
                        <TextBlock Text="{Binding [Cat_Game Launcher], Source={x:Static services:LocalizationService.Instance}}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{DynamicResource ColNeonPurple}" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        
                        <!-- Game list -->
                        <StackPanel x:Name="GameLauncherContent">
                            <TextBlock Text="{Binding [GameLauncherDesc], Source={x:Static services:LocalizationService.Instance}}" FontSize="14" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,20"/>
                            
                            <Button x:Name="AddGameButton" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Padding="14,10" Margin="0,0,0,20" Click="AddGameButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="+" FontSize="16" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [AddGameBtn], Source={x:Static services:LocalizationService.Instance}}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <ItemsControl x:Name="GameListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" FontSize="15" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                                            <Button Grid.Column="1" Style="{StaticResource PillButton}" Content="{Binding [PlayBtn], Source={x:Static services:LocalizationService.Instance}}" Padding="16,8" Margin="0,0,8,0" Click="PlayGameButton_Click"/>
                                            <Button Grid.Column="2" Style="{StaticResource PillButton}" Content="{Binding [RemoveBtn], Source={x:Static services:LocalizationService.Instance}}" Padding="16,8" Click="RemoveGameButton_Click" Background="#442222" Foreground="#FF6666"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Game Packages panel: one-click curated bundles. -->
                <ScrollViewer x:Name="PackagesPanel" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">


                        <!-- Package cards -->
                        <StackPanel x:Name="PackageCards">
                            <TextBlock Text="{Binding [PkgSubtitle], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14"
                                       Foreground="{StaticResource BrushTextSecondary}"/>

                            <ItemsControl x:Name="PackageList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushCardTranslucent}"
                                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                                CornerRadius="14" Padding="18,14" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Package icon -->
                                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="26"
                                                           VerticalAlignment="Top" Margin="0,2,14,0"/>

                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Margin="0,5,0,0"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                                    <TextBlock Text="{Binding SafetyNote}" FontSize="10.5" Margin="0,5,0,0"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource BrushTextMuted}"/>

                                                    <!-- Live progress while running -->
                                                    <StackPanel Margin="0,9,0,0"
                                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                                                   Foreground="{StaticResource BrushNeonGreen}"/>
                                                        <ProgressBar Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue, Mode=OneWay}"
                                                                     Height="6" Margin="0,5,0,0" Background="#22222F"
                                                                     Foreground="{DynamicResource BrushNeonPurple}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Apply button -->
                                                <Button Grid.Column="2" Style="{StaticResource PillButton}"
                                                        Command="{Binding ApplyCommand}" MinWidth="120"
                                                        VerticalAlignment="Center" Margin="14,0,0,0">
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding [PkgApply], Source={x:Static services:LocalizationService.Instance}}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding [PkgRunning], Source={x:Static services:LocalizationService.Instance}}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- RAM panel: one slider card replacing the old per-size
                     profile tweaks. The slider snaps to the supported sizes
                     (index 0..8 maps to 4..64 GB); Apply runs the matching
                     profile, Revert restores the Windows defaults. -->
                <ScrollViewer x:Name="RamPanel" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0" MaxWidth="660" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding [RamTitle], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{DynamicResource ColNeonPurple}" BlurRadius="18"
                                                  ShadowDepth="0" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding [RamSubtitle], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{StaticResource BrushTextSecondary}"/>

                        <Border Style="{StaticResource StatCard}" Margin="0,18,12,0" Padding="26,22">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding [RamSelectSize], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushTextMuted}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="RamValueText" Text="8 GB" FontSize="24" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushNeonGreen}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Slider x:Name="RamSlider" Style="{StaticResource NeonSlider}"
                                        Margin="0,16,0,2" ValueChanged="RamSlider_ValueChanged"/>

                                <!-- End labels of the slider range -->
                                <Grid Margin="9,4,9,0">
                                    <TextBlock Text="4 GB" Style="{StaticResource RamTick}"/>
                                    <TextBlock Text="64 GB" Style="{StaticResource RamTick}" HorizontalAlignment="Right"/>
                                </Grid>

                                <TextBlock x:Name="RamStateText" Text=" " FontSize="11.5" Margin="0,16,0,0"
                                           TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button x:Name="RamApplyButton" Style="{StaticResource PillButton}" MinWidth="140"
                                            Click="RamApply_Click"
                                            Content="{Binding [RamApply], Source={x:Static services:LocalizationService.Instance}}"/>
                                    <Button x:Name="RamRevertButton" Style="{StaticResource PillButton}" MinWidth="140" Margin="10,0,0,0"
                                            Click="RamRevert_Click"
                                            Content="{Binding [RamRevert], Source={x:Static services:LocalizationService.Instance}}"/>
                                </StackPanel>

                                <TextBlock x:Name="RamStatusText" Text=" " FontSize="10.5" Margin="0,12,0,0"
                                           Foreground="{StaticResource BrushNeonGreen}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Scan panel: free system scan; cleaning the findings is
                     the VIP part. Results render as cards with per-area
                     Clean buttons plus a Clean-all action. -->
                <ScrollViewer x:Name="ScanPanel" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding [ScanTitle], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{DynamicResource ColNeonPurple}" BlurRadius="18"
                                                  ShadowDepth="0" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding [ScanSubtitle], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="12.5" TextWrapping="Wrap" Margin="0,8,12,0"
                                   Foreground="{StaticResource BrushTextSecondary}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="ScanStartButton" Style="{StaticResource PillButton}" MinWidth="150"
                                    Click="ScanStart_Click"
                                    Content="{Binding [ScanStartBtn], Source={x:Static services:LocalizationService.Instance}}"/>
                            <Button x:Name="ScanCleanAllButton" Style="{StaticResource PillButton}" MinWidth="140" Margin="10,0,0,0"
                                    Visibility="Collapsed" Click="ScanCleanAll_Click"
                                    Content="{Binding [ScanCleanAllBtn], Source={x:Static services:LocalizationService.Instance}}"/>
                            <TextBlock x:Name="ScanReclaimableText" VerticalAlignment="Center" Margin="16,0,0,0"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushNeonGreen}"/>
                        </StackPanel>

                        <TextBlock x:Name="ScanStatusText" Text=" " FontSize="11.5" Margin="0,12,0,0"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <StackPanel x:Name="ScanResultsPanel" Margin="0,10,12,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- UWP Apps panel: safe built-in app remover. Browsing and
                     selecting is free; deleting the selected apps is the VIP
                     part. Searchable, multi-select list with per-app
                     installed status. -->
                <ScrollViewer x:Name="UwpPanel" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding [UwpTitle], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{DynamicResource ColNeonPurple}" BlurRadius="18"
                                                  ShadowDepth="0" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding [UwpSubtitle], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="12.5" TextWrapping="Wrap" Margin="0,8,12,0"
                                   Foreground="{StaticResource BrushTextSecondary}"/>

                        <!-- Search + actions -->
                        <Grid Margin="0,16,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <TextBox x:Name="UwpSearchBox" Style="{StaticResource NeonInput}"
                                         TextChanged="UwpSearch_TextChanged"/>
                                <TextBlock x:Name="UwpSearchHint" IsHitTestVisible="False" FontSize="12"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock.Text>
                                        <Binding Path="[UwpSearchHint]" Source="{x:Static services:LocalizationService.Instance}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                            <Button x:Name="UwpSelectAllButton" Grid.Column="1" Style="{StaticResource PillButton}"
                                    MinWidth="100" Margin="0,0,10,0" Click="UwpSelectAll_Click"
                                    Content="{Binding [UwpSelectAllBtn], Source={x:Static services:LocalizationService.Instance}}"/>
                            <Button x:Name="UwpDeleteButton" Grid.Column="2" Style="{StaticResource PillButton}"
                                    MinWidth="120" Click="UwpDelete_Click"
                                    Content="{Binding [UwpDeleteBtn], Source={x:Static services:LocalizationService.Instance}}"/>
                        </Grid>

                        <TextBlock x:Name="UwpSelectedText" Text=" " FontSize="11.5" Margin="0,10,0,0"
                                   FontWeight="SemiBold" Foreground="{StaticResource BrushNeonGreen}"/>
                        <TextBlock x:Name="UwpStatusText" Text=" " FontSize="11.5" Margin="0,4,0,0"
                                   Foreground="{StaticResource BrushTextSecondary}"/>

                        <StackPanel x:Name="UwpListPanel" Margin="0,10,12,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Startup Apps panel: manage what runs at boot. Browsing is
                     free; disabling/enabling entries is the VIP part. Nothing
                     is ever deleted - disabled entries are parked and can be
                     re-enabled anytime. -->
                <ScrollViewer x:Name="StartupPanel" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding [StartupTitle], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{DynamicResource ColNeonPurple}" BlurRadius="18"
                                                  ShadowDepth="0" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding [StartupSubtitle], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="12.5" TextWrapping="Wrap" Margin="0,8,12,0"
                                   Foreground="{StaticResource BrushTextSecondary}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,12,0">
                            <Button x:Name="StartupDisableButton" Style="{StaticResource PillButton}" MinWidth="130"
                                    Margin="0,0,10,0" Click="StartupDisable_Click"
                                    Content="{Binding [StartupDisableBtn], Source={x:Static services:LocalizationService.Instance}}"/>
                            <Button x:Name="StartupEnableButton" Style="{StaticResource PillButton}" MinWidth="130"
                                    Click="StartupEnable_Click"
                                    Content="{Binding [StartupEnableBtn], Source={x:Static services:LocalizationService.Instance}}"/>
                        </StackPanel>

                        <TextBlock x:Name="StartupSelectedText" Text=" " FontSize="11.5" Margin="0,10,0,0"
                                   FontWeight="SemiBold" Foreground="{StaticResource BrushNeonGreen}"/>
                        <TextBlock x:Name="StartupStatusText" Text=" " FontSize="11.5" Margin="0,4,0,0"
                                   Foreground="{StaticResource BrushTextSecondary}"/>

                        <StackPanel x:Name="StartupListPanel" Margin="0,10,12,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- USB panel: one slider card per device class (keyboard and
                     mouse driver data queue sizes), replacing the old per-size
                     buffer cards. The hidden kb-*/mouse-* tweak entries stay
                     in TweakData so Game Packages keep working. -->
                <ScrollViewer x:Name="UsbPanel" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0" MaxWidth="660" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding [UsbTitle], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{DynamicResource ColNeonPurple}" BlurRadius="18"
                                                  ShadowDepth="0" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding [UsbSubtitle], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="12.5" TextWrapping="Wrap" Margin="0,8,12,0"
                                   Foreground="{StaticResource BrushTextSecondary}"/>

                        <!-- Keyboard buffer card -->
                        <Border Style="{StaticResource StatCard}" Margin="0,18,12,0" Padding="26,22">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding [UsbKeyboardLabel], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushTextMuted}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="KbValueText" Text="15 packets" FontSize="24" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushNeonGreen}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Slider x:Name="KbSlider" Style="{StaticResource NeonSlider}"
                                        Maximum="5" Margin="0,16,0,2" ValueChanged="KbSlider_ValueChanged"/>

                                <Grid Margin="9,4,9,0">
                                    <TextBlock Text="5" Style="{StaticResource RamTick}"/>
                                    <TextBlock Text="50" Style="{StaticResource RamTick}" HorizontalAlignment="Right"/>
                                </Grid>

                                <TextBlock x:Name="KbStateText" Text=" " FontSize="11.5" Margin="0,16,0,0"
                                           TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock x:Name="KbWarnText" Text=" " FontSize="11" Margin="0,5,0,0"
                                           TextWrapping="Wrap" FontWeight="SemiBold" Visibility="Collapsed"/>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button x:Name="KbApplyButton" Style="{StaticResource PillButton}" MinWidth="140"
                                            Click="KbApply_Click"
                                            Content="{Binding [UsbApplyBtn], Source={x:Static services:LocalizationService.Instance}}"/>
                                    <Button x:Name="KbRevertButton" Style="{StaticResource PillButton}" MinWidth="140" Margin="10,0,0,0"
                                            Click="KbRevert_Click"
                                            Content="{Binding [UsbRevertBtn], Source={x:Static services:LocalizationService.Instance}}"/>
                                </StackPanel>

                                <TextBlock x:Name="KbStatusText" Text=" " FontSize="10.5" Margin="0,12,0,0"
                                           Foreground="{StaticResource BrushNeonGreen}"/>
                            </StackPanel>
                        </Border>

                        <!-- Mouse buffer card -->
                        <Border Style="{StaticResource StatCard}" Margin="0,14,12,0" Padding="26,22">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding [UsbMouseLabel], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushTextMuted}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="MouseValueText" Text="15 packets" FontSize="24" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushNeonGreen}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Slider x:Name="MouseSlider" Style="{StaticResource NeonSlider}"
                                        Maximum="5" Margin="0,16,0,2" ValueChanged="MouseSlider_ValueChanged"/>

                                <Grid Margin="9,4,9,0">
                                    <TextBlock Text="5" Style="{StaticResource RamTick}"/>
                                    <TextBlock Text="50" Style="{StaticResource RamTick}" HorizontalAlignment="Right"/>
                                </Grid>

                                <TextBlock x:Name="MouseStateText" Text=" " FontSize="11.5" Margin="0,16,0,0"
                                           TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock x:Name="MouseWarnText" Text=" " FontSize="11" Margin="0,5,0,0"
                                           TextWrapping="Wrap" FontWeight="SemiBold" Visibility="Collapsed"/>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button x:Name="MouseApplyButton" Style="{StaticResource PillButton}" MinWidth="140"
                                            Click="MouseApply_Click"
                                            Content="{Binding [UsbApplyBtn], Source={x:Static services:LocalizationService.Instance}}"/>
                                    <Button x:Name="MouseRevertButton" Style="{StaticResource PillButton}" MinWidth="140" Margin="10,0,0,0"
                                            Click="MouseRevert_Click"
                                            Content="{Binding [UsbRevertBtn], Source={x:Static services:LocalizationService.Instance}}"/>
                                </StackPanel>

                                <TextBlock x:Name="MouseStatusText" Text=" " FontSize="10.5" Margin="0,12,0,0"
                                           Foreground="{StaticResource BrushNeonGreen}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Category header + risk legend -->
                <StackPanel x:Name="ListHeader" Grid.Row="0" Visibility="Collapsed">
                    <TextBlock x:Name="HeaderText" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource ColNeonPurple}" BlurRadius="18"
                                              ShadowDepth="0" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="HeaderHint" FontSize="12.5" Margin="0,6,0,10"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Text="{Binding [HeaderHint], Source={x:Static services:LocalizationService.Instance}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource BrushRiskSafe}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding [RiskSafe], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource BrushRiskMod}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding [RiskMod], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource BrushRiskHigh}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding [RiskHigh], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Tweak cards: big square tiles that flow into a grid -->
                <ScrollViewer x:Name="TweakScroll" Grid.Row="1" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <ItemsControl x:Name="TweakList" ItemTemplate="{StaticResource TweakCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ===================== TOAST NOTIFICATION ===================== -->
        <!-- Completion / failure feedback for tweak runs. Non-interactive
             overlay floating above everything; auto-hides after a few seconds.
             Accent (dot + border) is green for success, red for failure. -->
        <Border x:Name="ToastHost" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,30" Padding="18,12" CornerRadius="12" MaxWidth="560"
                Background="#F2151622" BorderThickness="1" Opacity="0"
                Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="100">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.55" Color="#FF000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ToastDot" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,10,0"
                         Fill="{StaticResource BrushNeonGreen}">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.9"
                                          Color="{StaticResource ColNeonGreen}"/>
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock x:Name="ToastText" Text="" FontSize="13" FontWeight="Medium"
                           Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
